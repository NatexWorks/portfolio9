{
  "name": "natexworks-setdemo",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run content:extract && node scripts/prepare-public-assets.mjs",
    "prebuild": "npm run content:extract && node scripts/prepare-public-assets.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "content:extract": "node scripts/extract-legacy-content.mjs",
    "content:verify": "node scripts/verify-content.mjs",
    "test:browser": "node scripts/browser-qa.mjs && node scripts/interactions-qa.mjs",
    "test:puppeteer": "node scripts/puppeteer-qa.mjs",
    "visual:backstop:reference": "backstop reference --config=backstop.config.cjs",
    "visual:backstop": "backstop test --config=backstop.config.cjs",
    "visual:percy": "percy exec -- node scripts/percy-visual-qa.mjs",
    "visual:applitools": "node scripts/applitools-visual-qa.mjs",
    "test:visual": "npm run test:puppeteer && npm run visual:backstop"
  },
  "dependencies": {
    "@react-three/fiber": "^9.1.2",
    "gsap": "^3.14.2",
    "next": "^16.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.4.3",
    "playwright": "1.65.0",
    "typescript": "^5.9.0",
    "@applitools/eyes-playwright": "1.51.4",
    "@percy/cli": "1.32.12",
    "@percy/playwright": "1.1.2",
    "backstopjs": "6.3.25",
    "puppeteer-core": "25.17.0"
  }
}
